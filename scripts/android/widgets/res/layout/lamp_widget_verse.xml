<?xml version="1.0" encoding="utf-8"?>
<!-- Verse of the day. The sample text below is what the widget picker previews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lamp_w_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VERSE OF THE DAY"
            android:textColor="#FFB0BBDD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <ImageView
            android:id="@+id/w_share"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:contentDescription="Share verse"
            android:src="@drawable/lamp_w_share" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Psalm 119:105"
        android:textColor="#FFFFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.2"
        android:text="Your word is a lamp to my feet and a light to my path."
        android:textColor="#FFF3F5FF"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/w_tr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="BSB"
        android:textColor="#FFB0BBDD"
        android:textSize="12sp" />
</LinearLayout>
